# Maintainer: Zuhaib Ullah Baig
#
# Arch and Omarchy build from a release tag:
#
#   makepkg -si
pkgname=teral
pkgver=0.1.0
pkgrel=1
pkgdesc="A modern native Linux file manager written in Rust with GTK4"
# Add another architecture only after its release artifact has been built and tested.
arch=('x86_64')
url="https://github.com/zuhaibullahbaig/teral"
license=('MIT')
depends=('gtk4>=4.12' 'vte4>=0.66' 'glib2')
makedepends=('rust' 'cargo' 'pkgconf')
options=('!lto')  # the release profile already does full LTO
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# The GitHub source archive does not exist until the first tag is pushed. Before this
# recipe is published to the AUR, run `updpkgsums` against that immutable release tag.
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  export CARGO_TARGET_DIR=target
  cargo build --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  # The GUI tests need no display: they cover configuration, themes and file logic.
  cargo test --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/teral "$pkgdir/usr/bin/teral"
  install -Dm644 packaging/dev.zuhaibullahbaig.Teral.desktop \
    "$pkgdir/usr/share/applications/dev.zuhaibullahbaig.Teral.desktop"
  install -Dm644 packaging/dev.zuhaibullahbaig.Teral.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.zuhaibullahbaig.Teral.svg"
  install -Dm644 packaging/dev.zuhaibullahbaig.Teral.metainfo.xml \
    "$pkgdir/usr/share/metainfo/dev.zuhaibullahbaig.Teral.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
